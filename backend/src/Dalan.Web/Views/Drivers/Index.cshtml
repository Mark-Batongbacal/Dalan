@model DriverRegistryViewModel
@{
    ViewData["Title"] = "Driver registry";
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 page-heading">
    <div>
        <span class="page-kicker">Fleet administration</span>
        <h1>Driver registry</h1>
        <p>Maintain license details and one active vehicle assignment per driver.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add driver</a>
</div>
<div class="content-card">
    @if (Model.Drivers.Count == 0)
    {
        <div class="alert alert-info mb-0" role="status">No drivers have been registered yet.</div>
    }
    else
    {
        <div class="table-responsive registry-table">
            <table class="table align-middle">
                <thead><tr><th scope="col">Name</th><th scope="col">Phone</th><th scope="col">License</th><th scope="col">Expires</th><th scope="col">Availability</th><th scope="col">Vehicle</th><th scope="col">Actions</th></tr></thead>
                <tbody>
                @foreach (var driver in Model.Drivers)
                {
                    <tr>
                        <td data-label="Name">@driver.Name</td>
                        <td data-label="Phone">@driver.Phone</td>
                        <td data-label="License">@driver.LicenseNumber</td>
                        <td data-label="Expires">@driver.LicenseExpiry.ToString("yyyy-MM-dd")</td>
                        <td data-label="Availability"><span class="status-chip">@driver.Availability</span></td>
                        <td data-label="Vehicle">@(driver.VehicleRegistration ?? "—")</td>
                        <td data-label="Actions"><a asp-action="Edit" asp-route-id="@driver.Id" aria-label="Edit @driver.Name">Edit</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
