@model DriverRegistryViewModel
@{
    ViewData["Title"] = "Driver registry";
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 page-heading">
    <div>
        <span class="page-kicker">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><circle cx="6" cy="6" r="6"/></svg>
            Fleet administration
        </span>
        <h1>Driver Registry</h1>
        <p>Maintain license details and one active vehicle assignment per driver.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary" style="flex-shrink:0">
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M10 4v12M4 10h12"/></svg>
        Add driver
    </a>
</div>

<div class="table-wrap registry-table">
    @if (Model.Drivers.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="7" cy="6" r="3.5"/><path d="M1 18c0-4 2.7-6 6-6"/><circle cx="15" cy="12" r="3"/><path d="M12 18v-.5a3 3 0 016 0V18"/>
                </svg>
            </div>
            <h3>No drivers registered</h3>
            <p>Add your first driver to start assigning vehicles and planning routes.</p>
            <a asp-action="Create" class="btn btn-primary btn-sm" style="margin-top:8px">Add first driver</a>
        </div>
    }
    else
    {
        <div class="table-responsive-wrap" tabindex="0" role="region" aria-label="Scrollable data table">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Phone</th>
                        <th scope="col">License</th>
                        <th scope="col">Expires</th>
                        <th scope="col">Availability</th>
                        <th scope="col">Vehicle</th>
                        <th scope="col">Mobile account</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var driver in Model.Drivers)
                    {
                        <tr>
                            <td data-label="Name"><strong>@driver.Name</strong></td>
                            <td data-label="Phone" style="font-size:13px">@driver.Phone</td>
                            <td data-label="License" style="font-family:monospace;font-size:13px">@driver.LicenseNumber</td>
                            <td data-label="Expires" style="font-size:13px;white-space:nowrap">@driver.LicenseExpiry.ToString("yyyy-MM-dd")</td>
                            <td data-label="Availability">
                                @{
                                    var avail = driver.Availability?.ToString() ?? "Unknown";
                                    var chipClass = avail switch {
                                        "Available" => "status-chip status-chip-success",
                                        "Unavailable" => "status-chip status-chip-danger",
                                        "OnDuty" or "Active" => "status-chip status-chip-accent",
                                        _ => "status-chip status-chip-default"
                                    };
                                }
                                <span class="@chipClass">@avail</span>
                            </td>
                            <td data-label="Vehicle" style="font-size:13px">@(driver.VehicleRegistration ?? "—")</td>
                            <td data-label="Mobile account"><span data-mobile-access-status="@driver.Id" role="status">Loading…</span></td>
                            <td data-label="Actions"><div class="d-flex flex-wrap gap-2">
                                <a href="/Drivers/@driver.Id/Access" class="btn btn-ghost btn-sm" aria-label="Manage mobile access for @driver.Name">Mobile access</a>
                                <a asp-action="Edit" asp-route-id="@driver.Id"
                                   class="btn btn-ghost btn-sm"
                                   aria-label="Edit @driver.Name">
                                    <svg width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3l3 3L7 16H4v-3L14 3z"/></svg>
                                    Edit
                                </a>
                            </div></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts { <script src="~/js/driver-administration.js" asp-append-version="true"></script> }
