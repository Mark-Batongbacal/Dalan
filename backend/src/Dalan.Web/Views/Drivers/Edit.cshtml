@model DriverFormViewModel
@{
    ViewData["Title"] = "Edit driver";
}

<div class="page-heading">
    <span class="page-kicker">Fleet administration</span>
    <h1>Edit @Model.Name</h1>
    <p>Only available drivers with a current license can hold a vehicle assignment. Changing availability releases an assignment.</p>
</div>
<div class="content-card form-panel-wide">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" type="tel" /><span asp-validation-for="Phone" class="text-danger"></span></div>
        <div class="row g-3 mb-3">
            <div class="col-sm-6"><label asp-for="LicenseNumber" class="form-label"></label><input asp-for="LicenseNumber" class="form-control" /><span asp-validation-for="LicenseNumber" class="text-danger"></span></div>
            <div class="col-sm-6"><label asp-for="LicenseExpiry" class="form-label"></label><input asp-for="LicenseExpiry" class="form-control" type="date" /><span asp-validation-for="LicenseExpiry" class="text-danger"></span></div>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-sm-6">
                <label asp-for="Availability" class="form-label"></label>
                <select asp-for="Availability" class="form-select"><option value="Available">Available</option><option value="Unavailable">Unavailable</option><option value="Inactive">Inactive</option></select>
                <span asp-validation-for="Availability" class="text-danger"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="AssignedVehicleId" class="form-label"></label>
                <select asp-for="AssignedVehicleId" asp-items="Model.Vehicles" class="form-select"><option value="">No vehicle</option></select>
                <span asp-validation-for="AssignedVehicleId" class="text-danger"></span>
            </div>
        </div>
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a asp-action="Index" class="btn btn-outline-secondary ms-2">Back to drivers</a>
    </form>
</div>
@if (Model.Availability != "Inactive")
{
    <form asp-action="Deactivate" asp-route-id="@Model.Id" method="post" class="mt-3">
        <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Deactivate this driver and release the vehicle?')">Deactivate driver</button>
    </form>
}
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
