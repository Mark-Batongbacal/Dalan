@model DeliveryWorkflowViewModel
@{ ViewData["Title"]="Delivery workflow"; }
<div class="page-heading"><h1>Your delivery workflow</h1></div>
@if(TempData["WorkflowNotice"] is string notice) { <p class="alert alert-success" role="status">@notice</p> }
<div class="workflow-grid">
    <section class="content-card workflow-step"><span class="workflow-number">1</span><h2>Set a warehouse</h2><p>@(Model.Warehouse is null ? "Default pickup for deliveries and plans." : $"Default: {Model.Warehouse.Name}.")</p><a href="/Warehouse?workflow=guide" class="btn btn-primary">@(Model.Warehouse is null ? "Set warehouse" : "View or change warehouse")</a></section>
    <section class="content-card workflow-step" id="fleet"><span class="workflow-number">2</span><h2>Prepare drivers &amp; vehicles</h2><p>@Model.Drivers registered drivers · @Model.Vehicles vehicles. Ask Admin to update registrations and vehicle links.</p><div class="workflow-actions"><a href="/DispatchBoard/Drivers?workflow=guide" class="btn btn-outline-secondary">Check driver roster</a><a href="/Vehicles?workflow=guide" class="btn btn-outline-secondary">Check vehicles</a></div><p class="form-text">Requires available drivers, valid licenses and linked available vehicles.</p></section>
    <section class="content-card workflow-step" id="create"><span class="workflow-number">3</span><h2>Place your deliveries</h2><p>Add recipient, destination, weight and time. Pickup uses your warehouse.</p><div class="workflow-actions"><a href="/Deliveries/Create?workflow=guide" class="btn btn-primary">Create one delivery</a><a href="/DeliveryBatch?workflow=guide" class="btn btn-outline-secondary">Create multiple deliveries</a></div></section>
    <section class="content-card workflow-step"><span class="workflow-number">4</span><h2>Assign drivers &amp; vehicles</h2><p>@Model.Deliveries pending or assigned deliveries · @Model.Assigned currently assigned. Assign a driver and linked vehicle.</p><a href="/DeliveryWorkflow/Assignments?workflow=guide" class="btn btn-primary">Review assignments</a><p class="form-text">Unassigned work can be allocated during planning.</p></section>
    <section class="content-card workflow-step"><span class="workflow-number">5</span><h2>Plan &amp; dispatch</h2><p>Select deliveries, vehicles and a strategy. Preview, review, then confirm.</p><a href="/DispatchBoard?workflow=guide" class="btn btn-primary">Open fleet dispatch</a></section>
    <section class="content-card workflow-step"><span class="workflow-number">6</span><h2>Track the fleet</h2><p>View shared locations, delivery status and proof.</p><div class="workflow-actions"><a href="/FleetTracking?workflow=guide" class="btn btn-primary">Open tracking</a><a href="/Deliveries?workflow=guide" class="btn btn-outline-secondary">View delivery queue</a></div><p class="form-text">Drivers must enable location sharing.</p></section>
</div>
<details class="content-card mt-4"><summary>Advanced planning tools</summary><p class="form-text">Experiments only; routes are not saved.</p><a href="/FleetPlanner?mode=advanced&amp;workflow=guide">Open unsaved route sandbox</a></details>
