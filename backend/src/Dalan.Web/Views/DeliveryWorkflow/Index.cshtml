@model DeliveryWorkflowViewModel
@{ ViewData["Title"]="Delivery workflow"; }
<div class="page-heading"><span class="page-kicker">From warehouse to delivery</span><h1>Your delivery workflow</h1><p>Follow these steps to prepare, assign, dispatch and track your deliveries.</p></div>
@if(TempData["WorkflowNotice"] is string notice) { <p class="alert alert-success" role="status">@notice</p> }
<div class="workflow-grid">
    <section class="content-card workflow-step"><span class="workflow-number">1</span><h2>Set a warehouse</h2><p>@(Model.Warehouse is null ? "Choose the pickup location used by your new deliveries and plans." : $"Default: {Model.Warehouse.Name}. Saved to your Dispatcher account.")</p><a href="/Warehouse" class="btn btn-primary">@(Model.Warehouse is null ? "Set warehouse" : "View or change warehouse")</a></section>
    <section class="content-card workflow-step" id="fleet"><span class="workflow-number">2</span><h2>Prepare drivers &amp; vehicles</h2><p>@Model.Drivers registered drivers · @Model.Vehicles vehicles. Ask an Admin to register or update them and link each driver to a vehicle.</p><div class="workflow-actions"><a href="/DispatchBoard/Drivers" class="btn btn-outline-secondary">Check driver roster</a><a href="/Vehicles" class="btn btn-outline-secondary">Check vehicles</a></div><p class="form-text">Planning requires available drivers with current licenses and their assigned available vehicles.</p></section>
    <section class="content-card workflow-step" id="create"><span class="workflow-number">3</span><h2>Place your deliveries</h2><p>Enter recipients, destinations, weights and expected times. Your saved warehouse supplies the pickup.</p><div class="workflow-actions"><a href="/Deliveries/Create" class="btn btn-primary">Create one delivery</a><a href="/DeliveryBatch" class="btn btn-outline-secondary">Create multiple deliveries</a></div></section>
    <section class="content-card workflow-step"><span class="workflow-number">4</span><h2>Assign drivers &amp; vehicles</h2><p>@Model.Deliveries pending or assigned deliveries · @Model.Assigned currently assigned. Choose a driver and their vehicle for work you want to allocate yourself.</p><a href="/DeliveryWorkflow/Assignments" class="btn btn-primary">Review assignments</a><p class="form-text">You can leave work unassigned and let the selected planning technique allocate it in step 5.</p></section>
    <section class="content-card workflow-step"><span class="workflow-number">5</span><h2>Plan &amp; dispatch</h2><p>Select your saved deliveries and vehicles. Choose travel time, workload equity, warehouse rotation or earliest completion. Preview, review stop order, then confirm dispatch.</p><a href="/DispatchBoard" class="btn btn-primary">Open fleet dispatch</a></section>
    <section class="content-card workflow-step"><span class="workflow-number">6</span><h2>Track the fleet</h2><p>Follow shared driver locations and check each delivery’s server-accepted status and proof.</p><div class="workflow-actions"><a href="/FleetTracking" class="btn btn-primary">Open tracking</a><a href="/Deliveries" class="btn btn-outline-secondary">View delivery queue</a></div><p class="form-text">Live positions require the Driver to start sharing location during active deliveries.</p></section>
</div>
<details class="content-card mt-4"><summary>Advanced planning tools</summary><p class="form-text">Use the unsaved sandbox for experiments only. The main dispatch flow above uses actual saved deliveries.</p><a href="/FleetPlanner?mode=advanced">Open unsaved route sandbox</a></details>
