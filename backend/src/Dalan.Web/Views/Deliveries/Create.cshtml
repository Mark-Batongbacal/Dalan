@model CreateDeliveryViewModel
@{
    ViewData["Title"] = "Create delivery";
}

<div class="page-heading">
    <span class="page-kicker">Dispatch operations</span>
    <h1>Create delivery</h1>
    <p>Enter the recipient and pickup and drop-off locations.</p>
</div>

<div class="content-card form-panel">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="RecipientName" class="form-label"></label>
            <input asp-for="RecipientName" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="PickupAddress" class="form-label"></label>
            <input asp-for="PickupAddress" class="form-control" />
        </div>
        <div class="row g-3 mb-3">
            <div class="col-sm-6">
                <label asp-for="PickupLatitude" class="form-label"></label>
                <input asp-for="PickupLatitude" class="form-control"
                       type="number" step="any" />
            </div>
            <div class="col-sm-6">
                <label asp-for="PickupLongitude" class="form-label"></label>
                <input asp-for="PickupLongitude" class="form-control"
                       type="number" step="any" />
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="DropoffAddress" class="form-label"></label>
            <input asp-for="DropoffAddress" class="form-control" />
        </div>
        <div class="row g-3 mb-3">
            <div class="col-sm-6">
                <label asp-for="DropoffLatitude" class="form-label"></label>
                <input asp-for="DropoffLatitude" class="form-control"
                       type="number" step="any" />
            </div>
            <div class="col-sm-6">
                <label asp-for="DropoffLongitude" class="form-label"></label>
                <input asp-for="DropoffLongitude" class="form-control"
                       type="number" step="any" />
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-sm-6">
                <label asp-for="PayloadWeightKg" class="form-label"></label>
                <input asp-for="PayloadWeightKg" class="form-control"
                       type="number" step="0.01" min="0.01" />
            </div>
            <div class="col-sm-6">
                <label asp-for="ExpectedDeliveryAtUtc" class="form-label"></label>
                <input asp-for="ExpectedDeliveryAtUtc" class="form-control"
                       type="text" placeholder="2026-11-10T14:30:00+00:00" />
                <small class="form-text text-muted">
                    Include a time zone offset, such as +00:00 for UTC.
                </small>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Create delivery</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}