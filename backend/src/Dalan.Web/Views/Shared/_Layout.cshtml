@{
    var pageTitle = ViewData["Title"] as string ?? "Workspace";
    var signedIn = User.Identity?.IsAuthenticated == true;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var name = User.Identity?.Name ?? "";
    var initials = name.Length > 0 ? name[..1].ToUpperInvariant() : "D";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@pageTitle · Dalan</title>
    <script>
        (function () {
            var choice = 'system';
            try { choice = localStorage.getItem('dalan-theme') || choice; } catch {}
            if (!['system', 'light', 'dark'].includes(choice)) choice = 'system';
            document.documentElement.dataset.theme = choice;
        })();
    </script>
    <link rel="preload" href="~/lib/inter/Inter-Variable.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    @if (signedIn)
    {
        <!-- Sidebar overlay for mobile -->
        <div id="sidebar-overlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:39;" aria-hidden="true"></div>
    }

    <div class="app-shell">
        @if (signedIn)
        {
            <aside class="sidebar" id="main-navigation" aria-label="Main navigation">
                <a class="brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 32 40" width="32" height="40"><path fill="currentColor" d="M16 1C7.7 1 1 7.7 1 16c0 10.8 15 23 15 23s15-12.2 15-23C31 7.7 24.3 1 16 1Z"/><circle cx="16" cy="15" r="6" fill="#FFFAF6"/></svg></span>
                    <span>Dalan<small>Fleet workspace</small></span>
                </a>

                <nav class="sidebar-nav" aria-label="Primary">
                    @if (!User.IsInRole("Dispatcher") || User.IsInRole("Admin"))
                    {
                    <a class="@(controller == "Home" ? "active" : "")"
                       asp-controller="Home" asp-action="Index">
                        <svg class="nav-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M3 9.5L10 3l7 6.5V17a1 1 0 01-1 1H4a1 1 0 01-1-1V9.5z"/><path d="M7 18V11h6v7"/>
                        </svg>
                        Overview
                    </a>

                    }
                    @if (User.IsInRole("Dispatcher"))
                    {
                        <a class="@(controller == "DispatchBoard" && action != "Drivers" ? "active" : "")"
                           asp-controller="DispatchBoard" asp-action="Index">
                            <svg class="nav-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="2" y="2" width="7" height="8" rx="1.5"/><rect x="11" y="2" width="7" height="5" rx="1.5"/><rect x="11" y="10" width="7" height="8" rx="1.5"/><rect x="2" y="13" width="7" height="5" rx="1.5"/>
                            </svg>
                            Dispatch
                        </a>
                    }

                    <a class="@(controller == "Vehicles" ? "active" : "")"
                       asp-controller="Vehicles" asp-action="Index">
                        <svg class="nav-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="1" y="7" width="18" height="10" rx="2"/><path d="M4 7V5a2 2 0 012-2h8a2 2 0 012 2v2"/><circle cx="5.5" cy="17" r="1.5"/><circle cx="14.5" cy="17" r="1.5"/>
                        </svg>
                        Fleet registry
                    </a>

                    @if (User.IsInRole("Admin") || User.IsInRole("Dispatcher"))
                    {
                        <hr class="sidebar-divider" />
                        <span class="sidebar-section">Operations</span>

                        <a class="@(controller == "Analytics" ? "active" : "")"
                           asp-controller="Analytics" asp-action="Index">
                            <svg class="nav-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M4 15l4-5 3 3 3-4 2 2"/><rect x="2" y="2" width="16" height="16" rx="2"/>
                            </svg>
                            Analytics
                        </a>

                        <a class="@(controller == "Notifications" ? "active" : "")"
                           asp-controller="Notifications" asp-action="Index">
                            <svg class="nav-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M4 8a6 6 0 1112 0v4l1.5 2H2.5L4 12V8z"/><path d="M8 16h4"/>
                            </svg>
                            Operations email
                        </a>

                        <a class="@(controller == "GpsExceptions" ? "active" : "")"
                           href="/GpsExceptions">
                            <svg class="nav-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="10" cy="10" r="8"/><path d="M10 6v5"/><circle cx="10" cy="14.5" r=".5" fill="currentColor"/>
                            </svg>
                            GPS exceptions
                        </a>

                        <a class="@(controller == "FleetTracking" ? "active" : "")"
                           asp-controller="FleetTracking" asp-action="Index">
                            <svg class="nav-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="10" cy="10" r="3"/><path d="M10 2v2M10 16v2M2 10h2M16 10h2"/><path d="M4.2 4.2l1.4 1.4M14.4 14.4l1.4 1.4M4.2 15.8l1.4-1.4M14.4 5.6l1.4-1.4"/>
                            </svg>
                            Live fleet
                        </a>
                    }

                    @if (User.IsInRole("Dispatcher"))
                    {
                        <hr class="sidebar-divider" />
                        <span class="sidebar-section">Dispatch</span>
                        <a class="@(controller is "DeliveryWorkflow" or "Warehouse" or "DeliveryBatch" ? "active" : "")" href="/DeliveryWorkflow">Workflow guide</a>

                        <a class="@(controller == "Deliveries" ? "active" : "")"
                           asp-controller="Deliveries" asp-action="Index">
                            <svg class="nav-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M3 5h14M3 10h14M3 15h8"/>
                            </svg>
                            Delivery queue
                        </a>

                        <a class="@(controller == "DispatchBoard" && action == "Drivers" ? "active" : "")"
                           asp-controller="DispatchBoard" asp-action="Drivers">
                            <svg class="nav-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="8" cy="6" r="3"/><path d="M2 18c0-4 3-6 6-6s6 2 6 6"/><path d="M14 4a3 3 0 010 6M18 18c0-2.5-1.5-4.5-4-5.4"/>
                            </svg>
                            Drivers
                        </a>




                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <hr class="sidebar-divider" />
                        <span class="sidebar-section">Admin</span>

                        <a class="@((controller is "Drivers" or "DriverAccounts" || (controller == "DriverAdministration" && action == "Access")) ? "active" : "")"
                           asp-controller="Drivers" asp-action="Index">
                            <svg class="nav-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="7" cy="6" r="3"/><path d="M1 18c0-3.5 2.7-5.5 6-5.5"/><circle cx="15" cy="12" r="3"/><path d="M12 18v-1a3 3 0 016 0v1"/>
                            </svg>
                            Driver accounts
                        </a>

                        <a class="@((controller == "DriverAdministration" && action == "Audit") ? "active" : "")"
                           href="/AccountAudit">
                            <svg class="nav-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M9 11l3 3 6-6"/><path d="M4 4h12a1 1 0 011 1v12a1 1 0 01-1 1H4a1 1 0 01-1-1V5a1 1 0 011-1z"/>
                            </svg>
                            Account audit
                        </a>

                        <a class="@((controller == "DriverAdministration" && action == "Emails") ? "active" : "")" href="/DriverCredentialEmails">
                            <svg class="nav-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="2" y="5" width="16" height="12" rx="1.5"/><path d="M2 7l8 5 8-5"/>
                            </svg>
                            Credential emails
                        </a>

                        <a class="@(controller == "StaffAccounts" ? "active" : "")"
                           asp-controller="StaffAccounts" asp-action="Create">
                            <svg class="nav-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="8" cy="7" r="4"/><path d="M1 18c0-4 3-6 7-6"/><path d="M15 12v6M12 15h6"/>
                            </svg>
                            Staff accounts
                        </a>
                    }
                </nav>

                <div class="sidebar-foot">Internal operations</div>
            </aside>
        }

        <div class="main-column">
            <header class="topbar">
                @if (signedIn)
                {
                    <button class="nav-toggle btn-ghost btn" id="nav-toggle-btn" type="button"
                            aria-label="Toggle navigation" aria-expanded="false" aria-controls="main-navigation">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                            <path d="M3 5h14M3 10h14M3 15h14"/>
                        </svg>
                    </button>
                    <span class="topbar-title">@pageTitle</span>
                    <div class="topbar-actions">
                        <div class="account-badge">
                            <span class="account-avatar" aria-hidden="true">@initials</span>
                            <span class="account-name">@name</span>
                        </div>
                        <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0">
                            <button type="submit" class="btn btn-ghost btn-sm">Sign out</button>
                        </form>
                    </div>
                }
                else
                {
                    <a class="topbar-brand" asp-controller="Home" asp-action="Index">Dalan</a>
                    <span class="topbar-title">Fleet workspace</span>
                }
            </header>

            <main class="main-content" id="main-content" tabindex="-1">
                @if (User.IsInRole("Dispatcher") && controller == "DeliveryWorkflow")
                {
                    var step = controller switch { "Warehouse" => 1, "Vehicles" or "Drivers" => 2, "Deliveries" when action=="Create" => 3, "DeliveryBatch" => 3, "DeliveryWorkflow" when action=="Assignments" => 4, "Deliveries" => 4, "DispatchBoard" when action=="Drivers" => 2, "DispatchBoard" or "FleetPlanner" => 5, "FleetTracking" => 6, _ => 0 };
                    <partial name="_DeliverySteps" model="step" />
                }
                @RenderBody()
            </main>

            <footer class="app-footer">
                <span>Dalan · Internal fleet operations · <a asp-controller="Home" asp-action="Privacy">Privacy</a></span>
                <label>Appearance
                    <select id="theme-select" aria-label="Appearance">
                        <option value="system">System default</option>
                        <option value="light">Light</option>
                        <option value="dark">Dark</option>
                    </select>
                </label>
            </footer>
        </div>
    </div>

    <script>
        // Theme picker
        (function () {
            var select = document.getElementById('theme-select');
            select.value = document.documentElement.dataset.theme;
            select.addEventListener('change', function () {
                document.documentElement.dataset.theme = select.value;
                try { localStorage.setItem('dalan-theme', select.value); } catch {}
            });
        })();

    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if(User.IsInRole("Dispatcher")) { <script src="~/js/warehouse-selection.js" asp-append-version="true"></script> }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
