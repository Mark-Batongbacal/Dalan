@model EditVehicleViewModel
@{
    ViewData["Title"] = "Edit vehicle";
}

<div class="page-heading">
    <span class="page-kicker">Fleet administration</span>
    <h1>Edit @Model.RegistrationNumber</h1>
    <p>Keep vehicle capacity and availability current. Release its driver assignment before marking it unavailable.</p>
</div>
@if (TempData["VehicleError"] is string error)
{
    <div class="alert alert-warning" role="alert">@error</div>
}
<div class="content-card form-panel-wide">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="Type" class="form-label"></label>
            <input asp-for="Type" class="form-control" maxlength="64" />
            <span asp-validation-for="Type" class="text-danger"></span>
        </div>
        <div class="row g-3 mb-3">
            <div class="col-sm-6">
                <label asp-for="PayloadCapacityKg" class="form-label"></label>
                <input asp-for="PayloadCapacityKg" class="form-control" type="number" step="0.01" min="0.01" />
                <span asp-validation-for="PayloadCapacityKg" class="text-danger"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="SeatCapacity" class="form-label"></label>
                <input asp-for="SeatCapacity" class="form-control" type="number" min="1" />
                <span asp-validation-for="SeatCapacity" class="text-danger"></span>
            </div>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-sm-6">
                <label asp-for="Availability" class="form-label"></label>
                <select asp-for="Availability" class="form-select">
                    <option value="Available">Available</option>
                    <option value="Unavailable">Unavailable</option>
                    <option value="Maintenance">Maintenance</option>
                    <option value="Inactive">Inactive</option>
                </select>
                <span asp-validation-for="Availability" class="text-danger"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="NextMaintenanceDate" class="form-label"></label>
                <input asp-for="NextMaintenanceDate" class="form-control" type="date" />
                <span asp-validation-for="NextMaintenanceDate" class="text-danger"></span>
            </div>
        </div>
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a asp-action="Index" class="btn btn-outline-secondary ms-2">Back to fleet</a>
    </form>
</div>
@if (Model.Availability != "Inactive")
{
    <form asp-action="Deactivate" asp-route-id="@Model.Id" method="post" class="mt-3">
        <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Deactivate this vehicle?')">Deactivate vehicle</button>
    </form>
}
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
