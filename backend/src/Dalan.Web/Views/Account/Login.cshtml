@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="auth-wrap">
    <div class="content-card">
        <a class="auth-logo" asp-controller="Home" asp-action="Index">
            <img class="brand-logo" src="~/images/dalan-logo.png" alt="" width="48" height="48" />
            Dalan
        </a>
        <h1>Sign in</h1>
        <form asp-action="Login" method="post">
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="All" class="text-danger" role="alert" tabindex="-1"></div>

            <div class="form-group">
                <label asp-for="Email" class="form-label">Email address</label>
                <input asp-for="Email" class="form-control" aria-describedby="Email-validation"
                       autocomplete="username" placeholder="you@company.com" />
                <span id="Email-validation" asp-validation-for="Email" class="text-danger" style="font-size:13px"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password" class="form-label">Password</label>
                <div class="input-group">
                    <input asp-for="Password" class="form-control" aria-describedby="Password-validation"
                           autocomplete="current-password" placeholder="••••••••" />
                    <button id="toggle-password" class="btn btn-outline-secondary" type="button"
                            aria-controls="Password" aria-pressed="false" aria-label="Show password"
                            style="border-radius: 0 var(--r-sm) var(--r-sm) 0; min-width:90px">
                        Show
                    </button>
                </div>
                <span id="Password-validation" asp-validation-for="Password" class="text-danger" style="font-size:13px"></span>
            </div>

            <button class="btn btn-primary" type="submit" style="margin-top:8px">
                <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M15 3h4v14h-4M10 15l5-5-5-5M14 10H3"/>
                </svg>
                Sign in to workspace
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('toggle-password').addEventListener('click', function () {
            var password = document.getElementById('Password');
            var show = password.type === 'password';
            password.type = show ? 'text' : 'password';
            this.setAttribute('aria-pressed', String(show));
            this.textContent = show ? 'Hide' : 'Show';
            this.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
        });
    </script>
}
