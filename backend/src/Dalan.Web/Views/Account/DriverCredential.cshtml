<script>
    // Keep one-time credentials in memory only; remove them before other page scripts run.
    (() => {
        const fragment = new URLSearchParams(location.hash.slice(1));
        history.replaceState(null, '', location.pathname);
        const email = fragment.get('email');
        let token = fragment.get('token');
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('driver-credential');
            const status = document.getElementById('credential-status');
            const button = form.querySelector('button');
            const password = document.getElementById('new-password');
            const confirm = document.getElementById('confirm-password');
            if (!email || !token) {
                status.textContent = 'This link is incomplete. Request a new link from your administrator.';
                button.disabled = true;
            }
            form.addEventListener('submit', async event => {
                event.preventDefault();
                if (!email || !token) return;
                if (password.value !== confirm.value) {
                    status.textContent = 'The passwords must match.';
                    confirm.focus();
                    return;
                }
                button.disabled = true;
                status.textContent = 'Saving your password…';
                try {
                    const response = await fetch(form.dataset.endpoint, {
                        method: 'POST', credentials: 'omit', cache: 'no-store',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ email, token, password: password.value })
                    });
                    if (response.ok) {
                        token = null;
                        form.reset();
                        form.hidden = true;
                        status.textContent = 'Your password is set. Sign in using the Dalan Driver app.';
                    } else {
                        status.textContent = response.status === 503
                            ? 'This service is temporarily unavailable. Contact your administrator.'
                            : 'The password could not be saved. Use at least 12 characters with uppercase, lowercase, a number and a symbol, or request a new link if it has expired.';
                        button.disabled = false;
                    }
                } catch {
                    status.textContent = 'Unable to connect. Check your connection and try again.';
                    button.disabled = false;
                }
            });
        });
    })();
</script>
<div class="auth-wrap"><div class="content-card">
    <span class="auth-badge">Driver access</span>
    <h1>@ViewData["Title"]</h1>
    <p>Choose a private password. Use at least 12 characters with uppercase, lowercase, a number and a symbol.</p>
    <p id="credential-status" role="status" aria-live="polite"></p>
    <form id="driver-credential" data-endpoint="@ViewData["Endpoint"]">
        <div class="mb-3">
            <label for="new-password" class="form-label">New password</label>
            <input id="new-password" type="password" class="form-control" autocomplete="new-password" required minlength="12" maxlength="128" />
        </div>
        <div class="mb-3">
            <label for="confirm-password" class="form-label">Confirm password</label>
            <input id="confirm-password" type="password" class="form-control" autocomplete="new-password" required minlength="12" maxlength="128" />
        </div>
        <button type="submit" class="btn btn-primary">Save password</button>
    </form>
    <noscript>JavaScript is required to use this private link. Enable it and reopen the link from your email.</noscript>
</div></div>
