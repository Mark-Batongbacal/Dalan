@model DispatchBoardViewModel
@{
    ViewData["Title"] = "Dispatch board";
    var deliveryNames = Model.Deliveries.ToDictionary(
        x => x.Id, x => x.RecipientName);
    var vehicleNames = Model.Vehicles.ToDictionary(
        x => x.Id, x => x.RegistrationNumber);
}

<div class="page-heading">
    <span class="page-kicker">Dispatch operations</span>
    <h1>Dispatch board</h1>
    <p>Select deliveries and vehicles to preview a route plan.</p>
</div>

@if (Model.Error is not null)
{
    <div class="alert alert-danger" role="alert">@Model.Error</div>
}

<form asp-action="Index" method="post">
    <div class="content-card mb-4">
        <label asp-for="Strategy" class="form-label">Optimization strategy</label>
        <select asp-for="Strategy" class="form-select" aria-describedby="strategy-help">
            <option value="MinimumTotalTravelTime">Minimum total fleet travel time (default policy)</option>
            <option value="WorkloadEquity">Workload equity</option>
            <option value="WarehouseClusterRotation">Warehouse proximity clusters with rider rotation</option>
            <option value="EarliestFleetCompletion">Earliest fleet completion</option>
        </select>
        <p id="strategy-help" class="text-muted mt-2 mb-0">
            Travel time minimizes total driving; equity reduces the spread of rider work;
            warehouse mode groups nearby destinations and rotates rider priority after confirmation;
            earliest completion minimizes the longest rider workload.
            Only the selected heuristic runs when you preview. The default policy does not guarantee an optimal plan.
        </p>
        @if (Model.Advice is { } advice)
        {
            <div class="alert alert-info mt-3" role="status">
                <strong>Suggestion: @DispatchStrategyInput.Label(advice.Strategy)</strong>
                <p class="mb-1">@advice.Basis</p>
                <p class="mb-0">@advice.Confidence Select it above to use it for your preview.</p>
            </div>
        }
        <div class="row g-3 mt-1">
            <div class="col-md-6">
                <label asp-for="Settings.ServiceSecondsPerStop" class="form-label">Handling seconds per stop</label>
                <input asp-for="Settings.ServiceSecondsPerStop" type="number" min="0" max="3600" step="any" class="form-control" aria-describedby="handling-help" />
                <p id="handling-help" class="text-muted">Applied to each pickup and drop-off. Zero estimates driving time only.</p>
            </div>
            <div class="col-md-6">
                <label asp-for="Settings.MaxFleetTravelSeconds" class="form-label">Optional fleet travel budget (seconds)</label>
                <input asp-for="Settings.MaxFleetTravelSeconds" type="number" min="0" step="any" class="form-control" aria-describedby="budget-help" />
                <p id="budget-help" class="text-muted">For the three new strategies. Leave blank for no cap; exceeding it may leave deliveries unassigned.</p>
            </div>
        </div>
        <fieldset>
            <legend class="h6">Common warehouse (warehouse strategy only)</legend>
            <p class="text-muted">All selected starts and pickups must match this origin. New strategies require known weights and vehicle capacities.</p>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Settings.WarehouseLatitude" class="form-label">Warehouse latitude</label>
                    <input asp-for="Settings.WarehouseLatitude" type="number" min="-90" max="90" step="any" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Settings.WarehouseLongitude" class="form-label">Warehouse longitude</label>
                    <input asp-for="Settings.WarehouseLongitude" type="number" min="-180" max="180" step="any" class="form-control" />
                </div>
            </div>
        </fieldset>
    </div>
    <div class="content-card mb-4">
        <h2 class="h5">Available vehicles</h2>
        @if (Model.Vehicles.Count == 0)
        {
            <div class="alert alert-info mb-0" role="status">
                No vehicles are available for dispatch.
            </div>
        }
        else
        {
            @for (var i = 0; i < Model.Vehicles.Count; i++)
            {
                <div class="row g-3 align-items-end mb-3">
                    <div class="col-md-4">
                        <input asp-for="Vehicles[i].Id" type="hidden" />
                        <div class="form-check">
                            <input asp-for="Vehicles[i].Selected"
                                   class="form-check-input" />
                            <label asp-for="Vehicles[i].Selected"
                                   class="form-check-label">
                                @Model.Vehicles[i].RegistrationNumber
                            </label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Vehicles[i].StartLatitude"
                               class="form-label">Start latitude</label>
                        <input asp-for="Vehicles[i].StartLatitude"
                               class="form-control" type="number" step="any" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Vehicles[i].StartLongitude"
                               class="form-label">Start longitude</label>
                        <input asp-for="Vehicles[i].StartLongitude"
                               class="form-control" type="number" step="any" />
                    </div>
                </div>
            }
        }
    </div>

    <div class="content-card mb-4">
        <h2 class="h5">Eligible deliveries</h2>
        @if (Model.Deliveries.Count == 0)
        {
            <div class="alert alert-info mb-0" role="status">
                No pending or assigned deliveries are available.
            </div>
        }
        else
        {
            @for (var i = 0; i < Model.Deliveries.Count; i++)
            {
                <div class="form-check mb-3">
                    <input asp-for="Deliveries[i].Id" type="hidden" />
                    <input asp-for="Deliveries[i].Selected"
                           class="form-check-input" />
                    <label asp-for="Deliveries[i].Selected"
                           class="form-check-label">
                        <strong>@Model.Deliveries[i].RecipientName</strong>
                        (@Model.Deliveries[i].Status):
                        @Model.Deliveries[i].PickupAddress
                        → @Model.Deliveries[i].DropoffAddress
                    </label>
                </div>
            }
        }
    </div>

    <button type="submit" class="btn btn-primary">Preview routes</button>
    <button type="submit" asp-action="SuggestStrategy" class="btn btn-outline-secondary">Suggest strategy without routing</button>
</form>

@if (Model.Preview is not null)
{
    <div class="content-card mt-4">
        <h2 class="h5">Proposed routes</h2>
        <p>This preview does not reserve deliveries or save a dispatch plan.</p>
        <p><strong>@DispatchStrategyInput.Label(Model.Preview.Strategy)</strong></p>
        @if (Model.Preview.Metrics is { } metrics)
        {
            <p>Total travel: @((metrics.TotalTravelSeconds / 60).ToString("N1")) min;
                longest workload: @((metrics.LongestWorkloadSeconds / 60).ToString("N1")) min;
                workload spread: @((metrics.WorkloadSpreadSeconds / 60).ToString("N1")) min.</p>
            <ul class="text-muted">
                @foreach (var warning in metrics.Warnings) { <li>@warning</li> }
            </ul>
        }

        @foreach (var route in Model.Preview.Routes)
        {
            <section class="mb-4">
                <h3 class="h6">
                    @(vehicleNames.GetValueOrDefault(route.VehicleId)
                        ?? route.VehicleId.ToString())
                </h3>
                <p>
                    Start: @route.Start.Latitude, @route.Start.Longitude<br />
                    Estimated distance: @(route.DistanceMeters / 1000).ToString("N1") km;
                    time: @(route.DurationSeconds / 60).ToString("N0") minutes
                    <br />Deliveries: @(route.Stops.Count / 2)
                </p>
                @if (route.Stops.Count == 0)
                {
                    <p>No stops assigned to this vehicle.</p>
                }
                else
                {
                    <ol>
                        @foreach (var stop in route.Stops)
                        {
                            <li>
                                @stop.Kind:
                                @(deliveryNames.GetValueOrDefault(stop.DeliveryId)
                                    ?? stop.DeliveryId.ToString())
                            </li>
                        }
                    </ol>
                }
            </section>
        }

        @if (Model.Preview.UnassignedDeliveryIds.Count > 0)
        {
            <div class="alert alert-warning" role="status">
                <strong>Unassigned deliveries:</strong>
                @string.Join(", ", Model.Preview.UnassignedDeliveryIds.Select(
                    id => deliveryNames.GetValueOrDefault(id) ?? id.ToString()))
            </div>
        }
        @if (Model.Preview.UnassignedDeliveryIds.Count > 0)
        {
            <p>Deselect unassigned deliveries and preview again before reviewing a plan.</p>
        }
        else if (Model.Preview.Routes.Any(route => route.Stops.Count > 0))
        {
            <form asp-action="Review" method="post">
                <input name="Strategy" type="hidden" value="@Model.Preview.Strategy" />
                <input name="Settings.ServiceSecondsPerStop" type="hidden" value="@Model.Settings.ServiceSecondsPerStop" />
                <input name="Settings.MaxFleetTravelSeconds" type="hidden" value="@Model.Settings.MaxFleetTravelSeconds" />
                <input name="Settings.WarehouseLatitude" type="hidden" value="@Model.Settings.WarehouseLatitude" />
                <input name="Settings.WarehouseLongitude" type="hidden" value="@Model.Settings.WarehouseLongitude" />
                @for (var i = 0; i < Model.Vehicles.Count; i++)
                {
                    <input name="Vehicles[@i].Id"
                           type="hidden" value="@Model.Vehicles[i].Id" />
                    <input name="Vehicles[@i].Selected"
                           type="hidden" value="@Model.Vehicles[i].Selected.ToString().ToLowerInvariant()" />
                    <input name="Vehicles[@i].StartLatitude"
                           type="hidden" value="@Model.Vehicles[i].StartLatitude" />
                    <input name="Vehicles[@i].StartLongitude"
                           type="hidden" value="@Model.Vehicles[i].StartLongitude" />
                }
                @for (var i = 0; i < Model.Deliveries.Count; i++)
                {
                    <input name="Deliveries[@i].Id"
                           type="hidden" value="@Model.Deliveries[i].Id" />
                    <input name="Deliveries[@i].Selected"
                           type="hidden" value="@Model.Deliveries[i].Selected.ToString().ToLowerInvariant()" />
                }
                <button type="submit" class="btn btn-primary">
                    Review this plan
                </button>
            </form>
        }
    </div>
}
