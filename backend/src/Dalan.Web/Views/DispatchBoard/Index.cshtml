@model DispatchBoardViewModel
@{
    ViewData["Title"] = "Dispatch workspace";
    ViewData["ImmersiveMap"] = true;
    ViewData["MapSummaryDetail"] = Model.Preview is null ? null : $"{Model.Preview.Routes.Sum(r => r.DistanceMeters) / 1000:N1} km · {Model.Preview.Routes.Sum(r => r.DurationSeconds) / 60:N0} min total planned driving";
    var deliveryNames = Model.Deliveries.ToDictionary(
        x => x.Id, x => x.RecipientName);
    var vehicleNames = Model.Vehicles.ToDictionary(
        x => x.Id, x => x.RegistrationNumber);
}

@section Scripts {
    <script src="~/js/warehouse-selection.js" asp-append-version="true"></script><script src="~/js/dispatch-workspace.js" asp-append-version="true"></script>
    <partial name="_PlanningMapAssets" />
}
<div class="dispatch-workflow unified-dispatch" data-dispatch-workspace>
<div class="workspace-header page-heading">
    <div><span class="page-kicker">Operations / Dispatch</span><h1>Dispatch workspace</h1><p>Prepare deliveries. Preview routes. Confirm when ready.</p></div>
    <div class="workspace-header-actions"><a href="/Warehouse?workspace=true" class="warehouse-switch"><span aria-hidden="true">⌖</span><span data-workspace-warehouse>Choose your warehouse</span><span aria-hidden="true">↗</span></a><button type="submit" form="dispatch-preparation" class="btn btn-primary" data-preview-submit>Preview routes</button></div>
</div>
<partial name="_DispatchNavigation" model='@("prepare")' />
<div class="workspace-view-switch" role="group" aria-label="Workspace view"><button type="button" class="filter-chip active" data-workspace-view="deliveries" aria-pressed="true">Deliveries &amp; fleet</button><button type="button" class="filter-chip" data-workspace-view="map" aria-pressed="false">Map &amp; routes</button></div>
@if (ViewData["PreserveDispatchSelection"] is true) { <p role="status">Selections restored from review. Preview again to calculate a fresh plan.</p> }

@if (Model.Error is not null)
{
    <div class="alert alert-danger" role="alert" tabindex="-1" data-dispatch-error>@Model.Error<p class="mb-0">Check your selections and warehouse below, then preview again. Nothing has been dispatched.</p></div>
}

    <div class="location-workspace dispatch-reference-workspace">
        <aside class="location-workspace-map" data-map-form="dispatch-preparation" aria-label="Dispatch warehouse and route map">
            <partial name="_PlanningMap" model="PlanningMapViewModel.ForBoard(Model)" />
        </aside>
        <div class="location-workspace-fields">
<form id="dispatch-preparation" asp-action="Index" method="post" data-warehouse-selection
      data-warehouse-owner="@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)"
      data-warehouse-latitude="Settings_WarehouseLatitude" data-warehouse-longitude="Settings_WarehouseLongitude"
      data-warehouse-address="Settings_WarehouseAddress" data-warehouse-restore="@(ViewData.ModelState.Count == 0 && ViewData["PreserveDispatchSelection"] is not true ? "true" : "false")">
    <div asp-validation-summary="All" class="text-danger" role="alert" tabindex="-1"></div>

    <div class="workspace-progress" role="status" aria-live="polite" data-preview-progress hidden></div>
    <div class="workspace-selection-status" role="status" aria-live="polite" data-selection-status></div>
    <div class="content-card mb-4 dispatch-assignments">
        <div class="workspace-section-title"><h2>Delivery queue</h2><a href="/Deliveries/Create" class="btn btn-outline-secondary btn-sm">+ New</a></div><a href="/DeliveryBatch" class="workspace-batch-link">Add multiple deliveries</a>
        <div class="assignment-filters" role="group" aria-label="Filter eligible deliveries"><button type="button" class="filter-chip active" aria-pressed="true" data-delivery-filter="all">All (@Model.Deliveries.Count)</button><button type="button" class="filter-chip" aria-pressed="false" data-delivery-filter="Pending">Pending (@Model.Deliveries.Count(x => x.Status == "Pending"))</button><button type="button" class="filter-chip" aria-pressed="false" data-delivery-filter="Assigned">Assigned (@Model.Deliveries.Count(x => x.Status == "Assigned"))</button></div><label for="assignment-search" class="visually-hidden">Search eligible deliveries</label><input id="assignment-search" class="form-control" type="search" placeholder="Search recipient or address…" data-assignment-search /><p class="form-text" data-assignment-count role="status"></p>
        <p class="form-text">Select up to 15. Existing assignments stay with their vehicle.</p>

        @if (Model.Deliveries.Count == 0)
        {
            <div class="alert alert-info mb-0" role="status">
                No pending or assigned deliveries are available.
            </div>
        }
        else
        {
            <div class="assignment-list" tabindex="0" role="region" aria-label="Eligible delivery queue">
            @for (var i = 0; i < Model.Deliveries.Count; i++)
            {
                <div class="form-check mb-3 assignment-card" data-assignment-card data-status="@Model.Deliveries[i].Status">
                    <input asp-for="Deliveries[i].Id" type="hidden" />
                    <input asp-for="Deliveries[i].Selected"
                           class="form-check-input" />
                    <label asp-for="Deliveries[i].Selected"
                           class="form-check-label">
                        <strong>@Model.Deliveries[i].RecipientName</strong>
                        <span class="status-chip">@Model.Deliveries[i].Status</span>
                        <span class="delivery-address">@Model.Deliveries[i].PickupAddress → @Model.Deliveries[i].DropoffAddress</span>
                        @if (Model.Deliveries[i].AssignmentSummary is string assigned) { <span class="delivery-assignment">@assigned</span> }
                        @if (!Model.Deliveries[i].LocationsValid) { <span class="text-danger">Missing or invalid location. Open delivery details.</span> }
                    </label>
                </div>
            }
            </div>
        }
    </div>

    <details class="content-card mb-4 dispatch-vehicles" open="@(Model.Error is not null ? "open" : null)"><summary>Fleet readiness <span data-fleet-count>@Model.Vehicles.Count available</span></summary>
        <div class="fleet-options" tabindex="0" role="region" aria-label="Vehicle readiness and existing work estimates"><h2 class="h6">Choose 1 to 8 available vehicles</h2>
        <p class="text-muted">Every selected vehicle starts at the warehouse above. An available vehicle still needs an available driver with a current license; eligibility is checked when planning.</p>
        <p class="form-text">Existing work is remaining driving and handling outside this batch. Zero assumes no other work; equity and completion strategies use this estimate.</p>
        @if (Model.Vehicles.Count == 0)
        {
            <div class="alert alert-info mb-0" role="status">
                No vehicles are available for dispatch.
            </div>
        }
        else
        {
            @for (var i = 0; i < Model.Vehicles.Count; i++)
            {
                <div class="row g-3 align-items-end mb-3">
                    <div class="col-md-6">
                        <input asp-for="Vehicles[i].Id" type="hidden" />
                        <div class="form-check">
                            <input asp-for="Vehicles[i].Selected"
                                   class="form-check-input" />
                            <label asp-for="Vehicles[i].Selected"
                                   class="form-check-label">
                                <strong>@Model.Vehicles[i].RegistrationNumber</strong>
                                <span class="fleet-readiness">Available · @Model.Vehicles[i].Readiness</span>
                            </label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Vehicles[i].ExistingWorkloadSeconds" class="form-label">Existing work (seconds)</label>
                        <input asp-for="Vehicles[i].ExistingWorkloadSeconds" class="form-control" type="number" min="0" step="any" />
                        <span asp-validation-for="Vehicles[i].ExistingWorkloadSeconds" class="text-danger"></span>
                    </div>
                </div>
            }
        }
        </div>
    </details>

    <section class="content-card workspace-strategy"><h2 class="h6">Planning strategy</h2>
        <label asp-for="Strategy" class="form-label">Optimization strategy</label>
        <select asp-for="Strategy" class="form-select" aria-describedby="strategy-help">
            <option value="MinimumTotalTravelTime">Fastest fleet travel</option><option value="WorkloadEquity">Balanced workloads</option><option value="WarehouseClusterRotation">Nearby delivery groups</option><option value="EarliestFleetCompletion">Finish all routes sooner</option>
        </select><p id="strategy-help" class="form-text" data-strategy-description>Minimize total fleet driving. Only your selected strategy runs.</p>
    </section>
    <details class="content-card dispatch-options" open="@(Model.Error is not null || Model.Advice is not null || ViewData["PreserveDispatchSelection"] is true ? "open" : null)"><summary>Advanced planning settings</summary>
        <button type="submit" asp-action="SuggestStrategy" class="btn btn-outline-secondary">Suggest strategy without routing</button>
        @if (Model.Advice is { } advice)
        {
            <div class="alert alert-info mt-3" role="status">
                <strong>Optional suggestion: @DispatchStrategyInput.Label(advice.Strategy)</strong>
                <p class="mb-1">@advice.Basis</p>
                <p class="mb-0">@advice.Confidence Select it above to use it for your preview.</p>
            </div>
        }
        <div class="row g-3 mt-1">
            <div class="col-md-6">
                <label asp-for="Settings.ServiceSecondsPerStop" class="form-label">Handling seconds per stop</label>
                <input asp-for="Settings.ServiceSecondsPerStop" type="number" min="0" max="3600" step="any" class="form-control" aria-describedby="handling-help" />
                <p id="handling-help" class="text-muted">Applied to each pickup and drop-off. Zero estimates driving time only.</p>
            </div>
            <div class="col-md-6">
                <label asp-for="Settings.MaxFleetTravelSeconds" class="form-label">Optional fleet travel budget (seconds)</label>
                <input asp-for="Settings.MaxFleetTravelSeconds" type="number" min="0" step="any" class="form-control" aria-describedby="budget-help" />
                <p id="budget-help" class="text-muted">For the three new strategies. Leave blank for no cap; exceeding it may leave deliveries unassigned.</p>
            </div>
        </div>
        <fieldset>
            <legend class="h6">Warehouse</legend>
            <p class="text-muted">Select the warehouse for this dispatch. All selected vehicles start here. Your default is saved per Dispatcher. <a href="/Warehouse?workspace=true">Change saved warehouse</a>. Typed text does not confirm a map pin.</p>
            <div class="mb-3">
                <label asp-for="Settings.WarehouseAddress" class="form-label">Warehouse address or name</label>
                <input asp-for="Settings.WarehouseAddress" class="form-control" maxlength="500" />
            </div>
            <details data-map-coordinate-fields><summary>Advanced coordinates</summary><div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Settings.WarehouseLatitude" class="form-label">Warehouse latitude</label>
                    <input asp-for="Settings.WarehouseLatitude" type="number" min="-90" max="90" step="any" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Settings.WarehouseLongitude" class="form-label">Warehouse longitude</label>
                    <input asp-for="Settings.WarehouseLongitude" type="number" min="-180" max="180" step="any" class="form-control" />
                </div>
            </div></details>
            <p class="form-text" data-warehouse-status aria-live="polite"></p>
        </fieldset>
    </details>


</form>

@if (Model.Preview is not null)
{
    <div class="content-card mt-4 dispatch-plan-results" id="dispatch-plan-results">
        <div class="workspace-section-title"><h2 class="h5">Route preview</h2><span class="status-chip">Not dispatched</span></div>
        <p>This preview does not reserve deliveries or save a dispatch plan.</p>
        <p><strong>@DispatchStrategyInput.Label(Model.Preview.Strategy)</strong></p>
        @if (Model.Preview.Metrics is { } metrics)
        {
            <p>Total travel: @((metrics.TotalTravelSeconds / 60).ToString("N1")) min;
                longest workload: @((metrics.LongestWorkloadSeconds / 60).ToString("N1")) min;
                workload spread: @((metrics.WorkloadSpreadSeconds / 60).ToString("N1")) min.</p>
            @if (metrics.Warnings.Count > 0)
            {
                <details class="route-assumptions" open="@(Model.Preview.UnassignedDeliveryIds.Count > 0 ? "open" : null)"><summary>Planning assumptions (@metrics.Warnings.Count)</summary><ul class="text-muted">
                    @foreach (var warning in metrics.Warnings) { <li>@warning</li> }
                </ul></details>
            }
        }

        @foreach (var route in Model.Preview.Routes)
        {
            <section class="mb-4 planned-route-card" data-preview-route="@route.VehicleId">
                <button type="button" class="btn btn-outline-secondary btn-sm route-focus" data-focus-route="@route.VehicleId">View route on map</button>
                <h3 class="h6">
                    @(vehicleNames.GetValueOrDefault(route.VehicleId)
                        ?? route.VehicleId.ToString())
                </h3><p>Driver: @(Model.Vehicles.FirstOrDefault(v => v.Id == route.VehicleId)?.DriverName ?? "Determined on review / confirmation")</p>
                <div class="route-metrics"><strong>@((route.DistanceMeters / 1000).ToString("N1")) km</strong><span>@((route.DurationSeconds / 60).ToString("N0")) min driving</span><span>@route.Stops.Count stops</span></div>
                <details class="route-assumptions"><summary>Workload &amp; warehouse</summary><p>
                    Warehouse: @(Model.Settings.WarehouseAddress ?? "Confirmed map point")<br />
                    Estimated distance: @((route.DistanceMeters / 1000).ToString("N1")) km;
                    new driving time: @((route.DurationSeconds / 60).ToString("N0")) minutes<br />
                    Existing work: @((route.ExistingWorkloadSeconds / 60).ToString("N1")) minutes;
                    combined workload: @(((route.ExistingWorkloadSeconds + route.DurationSeconds + route.Stops.Count * Model.Settings.ServiceSecondsPerStop) / 60).ToString("N1")) minutes.
                    <br />Deliveries: @(route.Stops.Count / 2)
                </p></details>
                @if (route.Stops.Count == 0)
                {
                    <p>No stops assigned to this vehicle.</p>
                }
                else
                {
                    <ol>
                        @foreach (var stop in route.Stops)
                        {
                            <li>
                                @stop.Kind:
                                @(deliveryNames.GetValueOrDefault(stop.DeliveryId)
                                    ?? stop.DeliveryId.ToString())
                            </li>
                        }
                    </ol>
                }
            </section>
        }

        @if (Model.Preview.UnassignedDeliveryIds.Count > 0)
        {
            <div class="alert alert-warning" role="status">
                <strong>Unassigned deliveries:</strong>
                @string.Join(", ", Model.Preview.UnassignedDeliveryIds.Select(
                    id => deliveryNames.GetValueOrDefault(id) ?? id.ToString()))
            </div>
        }
        @if (Model.Preview.UnassignedDeliveryIds.Count > 0)
        {
            <p>These deliveries will not be dispatched. Check driver availability, assignments, capacity and reachable locations, or deselect them and preview again before reviewing a plan.</p>
        }
        else if (Model.Preview.Routes.Any(route => route.Stops.Count > 0))
        {
            <form asp-action="Review" method="post">
                <input name="Strategy" type="hidden" value="@Model.Preview.Strategy" />
                <input name="Settings.ServiceSecondsPerStop" type="hidden" value="@Model.Settings.ServiceSecondsPerStop" />
                <input name="Settings.MaxFleetTravelSeconds" type="hidden" value="@Model.Settings.MaxFleetTravelSeconds" />
                <input name="Settings.WarehouseLatitude" type="hidden" value="@Model.Settings.WarehouseLatitude" />
                <input name="Settings.WarehouseLongitude" type="hidden" value="@Model.Settings.WarehouseLongitude" />
                <input name="Settings.WarehouseAddress" value="@Model.Settings.WarehouseAddress" type="hidden" />
                @for (var i = 0; i < Model.Vehicles.Count; i++)
                {
                    <input name="Vehicles[@i].Id"
                           type="hidden" value="@Model.Vehicles[i].Id" />
                    <input name="Vehicles[@i].Selected"
                           type="hidden" value="@Model.Vehicles[i].Selected.ToString().ToLowerInvariant()" />
                    <input name="Vehicles[@i].ExistingWorkloadSeconds" value="@Model.Vehicles[i].ExistingWorkloadSeconds" type="hidden" />
                }
                @for (var i = 0; i < Model.Deliveries.Count; i++)
                {
                    <input name="Deliveries[@i].Id"
                           type="hidden" value="@Model.Deliveries[i].Id" />
                    <input name="Deliveries[@i].Selected"
                           type="hidden" value="@Model.Deliveries[i].Selected.ToString().ToLowerInvariant()" />
                }
                <p role="status" data-preview-validity></p>
                <button type="submit" class="btn btn-primary" data-review-preview>
                    Review this plan
                </button>
            </form>
        }
    </div>
}


</div></div>
</div>
