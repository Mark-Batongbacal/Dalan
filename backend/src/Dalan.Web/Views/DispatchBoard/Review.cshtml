@model DispatchReviewViewModel
@{
    ViewData["Title"] = "Review dispatch";
}

@section Scripts { <partial name="_PlanningMapAssets" /> }
<div class="dispatch-workflow">
<div class="page-heading">
    <span class="page-kicker">Dispatch operations</span>
    <h1>Review dispatch</h1>
    <p>
        Set a vehicle and order for each stop. A delivery's pickup and drop-off
        must stay on the same route, with pickup first.
    </p>
</div>

@if (Model.Error is not null)
{
    <div class="alert alert-danger" role="alert" tabindex="-1" data-dispatch-error>@Model.Error<p class="mb-0">Your review edits are retained. Retry confirmation after a temporary routing failure. If the plan is stale or eligibility changed, use Change selections and generate a fresh preview.</p></div>
}

<div class="content-card">
    <partial name="_PlanningMap" model="PlanningMapViewModel.ForReview(Model)" />
    <form asp-action="Confirm" method="post">
        <div asp-validation-summary="All" class="text-danger" role="alert" tabindex="-1"></div>
        <input asp-for="Strategy" type="hidden" />
        <input asp-for="Settings.ServiceSecondsPerStop" type="hidden" />
        <input asp-for="Settings.MaxFleetTravelSeconds" type="hidden" />
        <input asp-for="Settings.WarehouseLatitude" type="hidden" />
        <input asp-for="Settings.WarehouseLongitude" type="hidden" />
        <input asp-for="Settings.WarehouseAddress" type="hidden" />
        <input asp-for="RotationVersion" type="hidden" />
        <p><strong>Final review before saving.</strong> Confirm dispatch saves this plan and assigns its deliveries.
        </p><p>Strategy: @DispatchStrategyInput.Label(Model.Strategy). Reviewed stops are validated again on confirmation.</p>
        <p>All vehicles start at the selected warehouse: @Model.Settings.WarehouseAddress (@Model.Settings.WarehouseLatitude, @Model.Settings.WarehouseLongitude).</p>
        <p>Handling assumption: @Model.Settings.ServiceSecondsPerStop seconds per stop.
            Editing routes may change equity and completion estimates.</p>
        @for (var i = 0; i < Model.Vehicles.Count; i++)
        {
            <input asp-for="Vehicles[i].VehicleId" type="hidden" />
            <input asp-for="Vehicles[i].StartLatitude" type="hidden" />
            <input asp-for="Vehicles[i].StartLongitude" type="hidden" />
            <input asp-for="Vehicles[i].ExistingWorkloadSeconds" type="hidden" />
            <p>@Model.VehicleNames.GetValueOrDefault(Model.Vehicles[i].VehicleId, "Vehicle"): existing work estimate @Model.Vehicles[i].ExistingWorkloadSeconds.ToString("N0") seconds, outside this batch.</p>
        }

        @for (var i = 0; i < Model.Versions.Count; i++)
        {
            <input asp-for="Versions[i].DeliveryId" type="hidden" />
            <input asp-for="Versions[i].RowVersion" type="hidden" />
        }

        <div class="table-responsive registry-table" tabindex="0" role="region" aria-label="Scrollable data table">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th scope="col">Delivery</th>
                        <th scope="col">Stop</th>
                        <th scope="col">Vehicle</th>
                        <th scope="col">Order on vehicle</th>
                    </tr>
                </thead>
                <tbody>
                @for (var i = 0; i < Model.Stops.Count; i++)
                {
                    <tr>
                        <td data-label="Delivery">
                            @(Model.DeliveryNames.GetValueOrDefault(
                                Model.Stops[i].DeliveryId)
                                ?? Model.Stops[i].DeliveryId.ToString())
                            <input asp-for="Stops[i].DeliveryId" type="hidden" />
                        </td>
                        <td data-label="Stop">
                            @Model.Stops[i].Kind
                            <input asp-for="Stops[i].Kind" type="hidden" />
                        </td>
                        <td data-label="Vehicle">
                            <select asp-for="Stops[i].VehicleId"
                                    class="form-select"
                                    aria-label="Vehicle for @Model.Stops[i].Kind of @Model.DeliveryNames.GetValueOrDefault(Model.Stops[i].DeliveryId, Model.Stops[i].DeliveryId.ToString())">
                                @foreach (var vehicle in Model.Vehicles)
                                {
                                    <option value="@vehicle.VehicleId">
                                        @(Model.VehicleNames.GetValueOrDefault(
                                            vehicle.VehicleId)
                                            ?? vehicle.VehicleId.ToString())
                                    </option>
                                }
                            </select>
                        </td>
                        <td data-label="Order">
                            <input asp-for="Stops[i].Order"
                                   class="form-control" type="number"
                                   min="0" aria-label="Order for @Model.Stops[i].Kind of @Model.DeliveryNames.GetValueOrDefault(Model.Stops[i].DeliveryId, Model.Stops[i].DeliveryId.ToString())" />
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <button type="submit" class="btn btn-primary">
            Confirm dispatch
        </button>
        <button type="submit" asp-action="EditSelection" formnovalidate class="btn btn-outline-secondary">Change selections (new preview required)</button>
        <a asp-action="Index" class="btn btn-link">
            Start over (clear selections)
        </a>
    </form>
</div>

</div>
