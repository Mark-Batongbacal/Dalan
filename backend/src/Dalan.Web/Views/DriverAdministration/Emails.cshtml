@{ ViewData["Title"] = "Driver credential email status"; }
<div class="page-heading"><h1>Driver credential email status</h1><p>Provider acceptance does not establish inbox delivery. Pending messages retry automatically while valid. For expired or failed invitations, reissue from the Driver's mobile-access page. Drivers request a new recovery link themselves.</p></div>
<section class="content-card" data-credential-emails><button class="btn btn-outline-secondary" data-email-refresh>Refresh status</button><p data-table-status role="status"></p><div class="table-responsive" tabindex="0" role="region" aria-label="Scrollable data table"><table class="table"><caption>Recent invitation and recovery messages; no credentials or recipient addresses are shown</caption><thead><tr><th scope="col">Created (UTC)</th><th scope="col">Type</th><th scope="col">Status</th><th scope="col">Attempts</th><th scope="col">Provider accepted (UTC)</th></tr></thead><tbody></tbody></table></div></section>
@section Scripts { <script src="~/js/driver-administration.js" asp-append-version="true"></script> }
